{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athenaeum",
  "version": "0.1.0",
  "identifier": "com.athenaeum.sanctum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Athenaeum",
        "width": 1600,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#0E131F"
      },
      {
        "label": "quick-capture",
        "title": "Athenaeum Quick Capture",
        "url": "index.html?window=quick-capture",
        "width": 660,
        "height": 176,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Pablo Gonzalez",
    "copyright": "Copyright © 2026 Pablo Gonzalez",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
